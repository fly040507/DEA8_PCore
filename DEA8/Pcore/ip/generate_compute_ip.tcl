# Generate simulation/synthesis products only; never launch synthesis here.
set root [file normalize [file join [file dirname [info script]] ..]]
if {[llength $argv]>0} {set root [file normalize [lindex $argv 0]]}
set dest [file join $root ip generated]
file mkdir $dest
create_project -in_memory -part xcu50-fsvh2104-2-e
set_property target_language Verilog [current_project]
set_param general.maxThreads 1
set f [open [file join $root ip compute_ip_config.txt] w]
foreach {name operation usage latency ce} {
    pcore_fpadd_ip Add_Subtract Full_Usage 11 false
    dea8_fpadd_ip Add_Subtract Full_Usage 11 true
    dea8_fpmul_ip Multiply Full_Usage 6 true
    dea8_fpexp_ip Exponential Full_Usage 20 true
    dea8_fprecip_ip Reciprocal Full_Usage 28 true
} {
    set xci [file join $dest $name ${name}.xci]
    if {[file exists $xci]} {
        read_ip $xci
    } else {
        create_ip -name floating_point -vendor xilinx.com -library ip -version 7.1 -module_name $name -dir $dest
    }
        set props [list CONFIG.Operation_Type $operation CONFIG.A_Precision_Type Single \
            CONFIG.Result_Precision_Type Single CONFIG.Flow_Control NonBlocking \
            CONFIG.Has_ACLKEN $ce CONFIG.Has_ARESETn true CONFIG.Has_RESULT_TREADY false \
            CONFIG.C_Rate 1 CONFIG.Maximum_Latency true]
        if {$operation eq "Add_Subtract"} {lappend props CONFIG.Add_Sub_Value Add}
        if {$operation eq "Multiply" || $operation eq "Add_Subtract"} {lappend props CONFIG.C_Mult_Usage $usage}
        if {$operation eq "Exponential"} {lappend props CONFIG.C_BRAM_Usage Full_Usage}
        set_property -dict $props [get_ips $name]
    set ip [get_ips $name]
    set actual($name) [get_property CONFIG.C_Latency $ip]
    if {$name eq "pcore_fpadd_ip" && $actual($name) != 11} {error "DEQACC requires the validated eleven-cycle add configuration"}
    generate_target all $ip
    puts $f "$name operation=$operation latency=[get_property CONFIG.C_Latency $ip] rate=[get_property CONFIG.C_Rate $ip] multiply_usage=[get_property CONFIG.C_Mult_Usage $ip]"
}
close $f
set f [open [file join $root rtl dea8_compute_config_pkg.sv] w]
puts $f "// Generated by ip/generate_compute_ip.tcl (Vivado 2022.2)."
puts $f "package dea8_compute_config_pkg;"
puts $f "  parameter int FP_ADD_LATENCY=$actual(dea8_fpadd_ip);"
puts $f "  parameter int FP_MUL_LATENCY=$actual(dea8_fpmul_ip);"
puts $f "  parameter int FP_EXP_LATENCY=$actual(dea8_fpexp_ip);"
puts $f "  parameter int FP_RECIP_LATENCY=$actual(dea8_fprecip_ip);"
puts $f "  parameter int QUANT_LATENCY=5;"
puts $f "  parameter int GU_CREDITS=4;"
puts $f "endpackage"
close $f
puts "DEA8_COMPUTE_IP_READY no_synthesis=1"
exit 0
